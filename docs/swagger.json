{
    "swagger": "2.0",
    "info": {
        "description": "Сайт",
        "title": "API на Go со Swagger",
        "contact": {
            "name": "Александр",
            "url": "https://vk.com/a13handro"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Authorization"
                ],
                "summary": "Авторизация",
                "responses": {}
            }
        },
        "/api/auth/refresh-token": {
            "post": {
                "description": "метод вызывается автоматически из функции-оболочки (AuthMiddleware) при невалидном Accesstoken",
                "tags": [
                    "RefreshToken"
                ],
                "summary": "Обновление токена",
                "responses": {}
            }
        },
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Authorization"
                ],
                "summary": "Регистрация",
                "responses": {}
            }
        },
        "/api/posts": {
            "get": {
                "description": "Требует аутентификации.",
                "tags": [
                    "Posts"
                ],
                "summary": "Просмотр постов",
                "responses": {}
            },
            "post": {
                "description": "Требует аутентификации(Роль Автор).",
                "tags": [
                    "Posts"
                ],
                "summary": "Создание поста",
                "responses": {}
            }
        },
        "/api/posts/{postId}": {
            "put": {
                "description": "Требует аутентификации(Роль Автор).",
                "tags": [
                    "Posts"
                ],
                "summary": "Редактирование поста",
                "responses": {}
            }
        },
        "/api/posts/{postId}/images": {
            "post": {
                "description": "Требует аутентификации(Роль Автор).",
                "tags": [
                    "Image"
